############### PERSONAL NOTE ###############

# You: OMG YOU ACTUALLY INCLUDED YOUR ENV FILE WHAT A NOOB MOVE.
#
# Me: No, this was a conscious decision as none of the env values for this project are sensitive in nature.
# They are in .env simply for convenience and easy "One source for the End User" editing.
# The Steam dir is the closest to sensitive data and it uses the same default directory as any other machine.
# I simply got tired of maintaining the example env file with commentary since no one else uses this thing anyhow.

############### ENVIRONMENT VALUES ###############

# Logging output level to show in Console.  Off, All, Specific.  If specific, include argument to tell which ones
PROMPT_CONSOLE=false
# logging prompts to CSV files (true/false - STRING NOT BOOLEAN).
PROMPT_LOGGING=false
GAME_OUTPUT_CSV=debug/standard_logs/transcriptions_reworded_game_log.csv
TEST_OUTPUT_CSV=debug/standard_logs/transcriptions_reworded_test_log.csv

# Watch directory for WEM access - default Steam path placeholder.
# Users must replace this with their actual Steam install path if different. Default install assumes the following:
# "C:/Program Files (x86)/Steam/steamapps/common/No Man's Sky/GAMEDATA/MODS/DYNAMIC_SUIT_VOICE/AUDIO/WINDOWS/MEDIA/ENGLISH(US)"
MOD_DIR="C:/Program Files (x86)/Steam/steamapps/common/No Man's Sky/GAMEDATA/MODS/DYNAMIC_SUIT_VOICE/AUDIO/WINDOWS/MEDIA/ENGLISH(US)"

# Interval in seconds between access checks. Raising it will reduce frequency of file checks.
CHECK_INTERVAL="0.1"
# Stored output results per wem to minimize repeats, added as Do Not Word Like This in the context sent to LLM
MAX_SESSION_LINES=10

# temporary folders for storing wav and wem files
TEMP_WEM_DIR=cache/tmp_wem_dir
TEMP_WAV_DIR=cache/tmp_wav_dir

# maximum generate-ahead limit for Quick Response voice lines
QUICK_CACHE_MAX=15
# location for Quick Response files
QUICK_CACHE_DIR=cache/tmp_quick_dir
# Cache logs
CACHE_LOG_DIR=debug/standard_logs

# Batch file path for converting TTS WAV to WEM.
CMD_SCRIPT_PATH="sound2wem/zSound2wem.cmd"
# This will need to be downloaded from HF manually or can auto retrieve during setup.
LLM_MODEL=assets/qwen3_4b_q8/Qwen3-4B-Q8_0.gguf
# TTS model will be automatically downloaded by TTS if not present.  XTTS is for future implementation
TTS_MODEL="tts_models/en/ljspeech/tacotron2-DDC_ph"
# XTTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
# Icon for system tray; can be replaced by any appropriately sized image if so desired.
ICON_IMAGE="assets/nms_dsv.png"

# CSV for mapping WEM numbers to in-game phrases, includes additional context for LLM prompting
CSV_PATH="data/nms_suit_voice_transcripts.csv"

# Logit_bias tokens to constrain generation and discourage use of words and phrases that break immersion.
TOKENIZED_LOGITS_PATH=data/logit_bias.json

# Paths to files and Information for creating a full prompt.  Player Name intentionally quoted so it can include spaces.
SUIT_VOICE_BASE_PATH=data/base_prompt.txt
SUIT_VOICE_DYNAMIC_PATH=data/dynamic_prompt.txt
SUIT_VOICE_COMBAT_PATH=data/combat_prompt.txt
PROMPTDATA_PATH=data/prompt_data.json
PHRASE_WORDINESS=Standard
PHRASE_TONE=Standard
PLAYER_NAME="Traveler"
UNITS_CATEGORY_RECEIVED="Increased Funds"
UNITS_CATEGORY_INSUFFICIENT="Insufficient Funds"
COMBAT_CATEGORIES_ALLOW_REASONING=True
# Categories that require specialized prompting as they break standard prompting rules. Must be in quotes due to spaces in the names.
MIL_CATEGORIES="Missile Launch,Missile Destroyed,Dreadnought Departure,Dreadnought Disabled,Freighter Combat,Freighter Destroyed"
