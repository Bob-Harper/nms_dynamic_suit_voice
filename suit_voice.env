############### PERSONAL NOTE ###############

# You: OMG YOU ACTUALLY INCLUDED YOUR ENV FILE WHAT A NOOB MOVE.
#
# Me: No, this was a conscious decision as none of the env values for this project are sensitive in nature.
# They are all for convenience and easy "One source" editing.  The Steam dir is the closest to sensitive data and it
# uses the same default directory it would use on any user's machine.  Everything else is located in the project dir.
# I simply got tired of updating the example env file since no one else actually uses this thing anyhow.

############### ENVIRONMENT VALUES ###############

# Enable optional logging to CSV files (true/false).
LOGGING=false
GAME_OUTPUT_CSV=data/transcriptions_reworded_game_log.csv
TEST_OUTPUT_CSV=data/transcriptions_reworded_test_log.csv

# Watch directory for WEM access - default Steam path placeholder.
# Users must replace this with their actual Steam install path if different. Default assumes this:
# "C:/Program Files (x86)/Steam/steamapps/common/No Man's Sky/GAMEDATA/MODS/DYNAMIC_SUIT_VOICE/AUDIO/WINDOWS/MEDIA/ENGLISH(US)"
MOD_DIR="C:/Program Files (x86)/Steam/steamapps/common/No Man's Sky/GAMEDATA/MODS/DYNAMIC_SUIT_VOICE/AUDIO/WINDOWS/MEDIA/ENGLISH(US)"

# Interval in seconds between access checks.
# Lower the interval if you notice the same voice file being reused repeatedly.  raising it will reduce frequency of file checks.
CHECK_INTERVAL="0.1"

# temporary folders for storing wav and wem files
TEMP_WEM_DIR=tmp_wem_dir
TEMP_WAV_DIR=tmp_wav_dir

# Batch file path for converting to WEM.
CMD_SCRIPT_PATH="sound2wem/zSound2wem.cmd"

# This will need to be downloaded from HF manually or during setup.
LLM_MODEL=assets/qwen3_17b_q8/Qwen3-1.7B-Q8_0.gguf

# TTS model will be automatically downloaded by TTS if not present.  XTTS is unused at this time, left in for future implementation
TTS_MODEL="tts_models/en/ljspeech/tacotron2-DDC_ph"
# XTTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2

# Icon for system tray; can be replaced by any appropriately sized image if so desired.
ICON_IMAGE="assets/nms_dsv.png"

# CSV for mapping WEM numbers to phrases.
# Relative path inside project; users can customize this file but should be prepare for a lengthy testing period while
# looking to acheive the correct balance and wording.
CSV_PATH="data/nms_suit_voice_transcripts.csv"

# Information used for creating a full prompt with correct details.  Player Name left in quotes so it can include spaces if changed.
SUIT_VOICE_BASE_PATH=data/base_prompt.txt
SUIT_VOICE_DYNAMIC_PATH=data/dynamic_prompt.txt
SUIT_VOICE_COMBAT_PATH=data/combat_prompt.txt
PROMPTDATA_PATH=data/prompt_data.json
PHRASE_WORDINESS=Standard
PHRASE_TONE=Standard
PLAYER_NAME="Traveler"
UNITS_CATEGORY_RECEIVED="Increased Funds"
UNITS_CATEGORY_INSUFFICIENT="Insufficient Funds"
COMBAT_CATEGORIES_ALLOW_REASONING=True
# Categories that override prompting rules, most use spaces so must be in quotes
MIL_CATEGORIES="Missile Launch,Missile Destroyed,Dreadnought Departure,Dreadnought Disabled,Freighter Combat,Freighter Destroyed"
# List of WEM IDs for quick response, can add more like so 330331555,330331556,330331557
QUICK_RESPONSE_IDS=330331555
# Logit_bias tokens to constrain generation and discourage use of words and phrases that break immersion.
TOKENIZED_LOGITS_PATH=data/logit_bias.json
