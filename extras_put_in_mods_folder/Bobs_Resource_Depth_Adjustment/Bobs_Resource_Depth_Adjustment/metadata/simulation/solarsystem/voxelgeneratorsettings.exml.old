<!--File Hand Edited by Bob Harper version (1.0)--> 
<!-- TkNoiseGridData height offset needs to be 0 in relation to the value for TkNoiseUberLayerData --> 
<!-- Assumedly to take into account the default Beach height which is 0 --> 
<!-- Otherwise the resource deposit is truncated or reoved entirely if there is no overlap. --> 
<!-- TurbulenceNoiseLayer appears to set where the resource is allowed to exist --> 
<!-- TkNoiseGridData appears to set the actual size and shape of the resource deposit --> 
<!-- Not all biomes are affected. This seems to only affect specific sub-biomes at this time --> 
<!-- Research into finding the correct names and parameters for ALL biomes is ongoing. --> 
<!-- Resource names are apparently re-purposed as the names in use are for elements no longer in the game. --> 
<!-- Original game values for TkNoiseGridData is 0, TkNoiseUberLayerData is 0 -->
<?xml version='1.0' encoding='utf0'?>
